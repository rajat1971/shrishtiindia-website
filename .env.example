# This project needs no environment variables to run.
# The values below are only for optional tooling. Fill them in a local .env (never committed).

# Live site
SITE_URL=https://shrishtiindia.com

# Optional: WordPress Application Password for scripted access (wp-admin > Users > Profile > Application Passwords)
WP_USERNAME=
WP_APP_PASSWORD=

# Optional: SMTP for the enquiry form if PHP mail is unreliable (configure in a plugin, not here)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
